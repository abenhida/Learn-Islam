"use client";
import Link from "next/link";
import { useEffect, useState } from "react";
import { useAuth } from "../components/AuthProvider";
import { Alert, Badge, Card, PageTitle } from "../components/ui";
import { apiFetch } from "../lib/api";

export default function Home() {
  const { user } = useAuth();
  const [levels, setLevels] = useState(null);
  const [error, setError] = useState("");

  useEffect(() => {
    apiFetch("/api/v1/levels")
      .then(setLevels)
      .catch((err) => setError(err.message));
  }, []);

  return (
    <div>
      <PageTitle subtitle="Foundation build — curriculum levels">Islamic Learning LMS</PageTitle>

      {error && <Alert>{error}</Alert>}
      {!levels && !error && <p className="text-sm text-neutral-500">Loading levels...</p>}

      <div className="grid gap-4 sm:grid-cols-2">
        {levels?.map((level) => (
          <Card key={level.id}>
            <div className="flex items-start justify-between">
              <h3 className="font-semibold text-neutral-900">{level.name}</h3>
              <Badge tone="green">{level.passing_score}% to pass</Badge>
            </div>
            <p className="mt-2 text-sm text-neutral-600">{level.description}</p>
            {user ? (
              <Link href={`/levels/${level.id}`} className="mt-3 inline-block text-sm font-medium text-emerald-700 hover:underline">
                View materials →
              </Link>
            ) : (
              <Link href="/login" className="mt-3 inline-block text-sm font-medium text-emerald-700 hover:underline">
                Log in to view materials →
              </Link>
            )}
          </Card>
        ))}
      </div>

      {levels && levels.length === 0 && <p className="text-sm text-neutral-500">No levels published yet.</p>}
    </div>
  );
}

